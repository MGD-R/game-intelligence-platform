APP_NAME=game-intelligence-platform
APP_ENV=local
APP_VERSION=0.1.0
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
API_BASE_URL=http://app:8000
CORS_ALLOW_ORIGINS=http://localhost:8501,http://localhost:8000

POSTGRES_DB=gip
POSTGRES_USER=gip
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://gip:change-me@postgres:5432/gip
DATABASE_CONNECT_TIMEOUT=3

RAWG_API_KEY=change_me
STEAM_API_KEY=change_me
IGDB_CLIENT_ID=replace-me
IGDB_CLIENT_SECRET=replace-me
TWITCH_CLIENT_ID=change_me
TWITCH_CLIENT_SECRET=change_me
WIKIMEDIA_USER_AGENT=game-intelligence-platform/0.1 (your-email@example.com)

REQUEST_TIMEOUT_SECONDS=10
REQUEST_RETRY_ATTEMPTS=3
RAWG_REQUESTS_PER_SECOND=1
STEAM_REQUESTS_PER_SECOND=1
IGDB_REQUESTS_PER_SECOND=4
IGDB_MAX_CONCURRENT_REQUESTS=8
IGDB_MAX_ITEMS_PER_REQUEST=500
IGDB_DETAILS_LIMIT=50
WIKIMEDIA_REQUESTS_PER_MINUTE=120
WIKIPEDIA_PAGE_LIMIT=100
WIKIDATA_DEMO_LIMIT=5000
RAWG_MONTHLY_LIMIT=20000
RAWG_PAGE_SIZE=40
RAWG_DISCOVERY_PAGE_LIMIT=10
RAWG_DETAILS_LIMIT=0
STEAM_DETAILS_LIMIT=50
DEMO_MODE=true
RAWG_RATE_LIMIT_PER_MINUTE=60
WIKIDATA_RATE_LIMIT_PER_MINUTE=60
STEAM_RATE_LIMIT_PER_MINUTE=30
WIKIPEDIA_RATE_LIMIT_PER_MINUTE=30
IGDB_RATE_LIMIT_PER_MINUTE=20

DATA_ROOT=/app/data
GIP_WRITE_API_KEY=

MLFLOW_TRACKING_URI=http://mlflow:5000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=gip-artifacts

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me

LLM_PROVIDER=none
OPENAI_API_KEY=replace-me
LOCAL_LLM_BASE_URL=
