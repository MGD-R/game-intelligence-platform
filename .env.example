APP_NAME=game-intelligence-platform
APP_ENV=local
APP_VERSION=0.1.0
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

POSTGRES_DB=gip
POSTGRES_USER=gip
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://gip:change-me@postgres:5432/gip
DATABASE_CONNECT_TIMEOUT=3

RAWG_API_KEY=change_me
STEAM_API_KEY=replace-me
IGDB_CLIENT_ID=replace-me
IGDB_CLIENT_SECRET=replace-me
WIKIMEDIA_USER_AGENT=game-intelligence-platform/0.1.0 (contact: you@example.com)

REQUEST_TIMEOUT_SECONDS=10
REQUEST_RETRY_ATTEMPTS=3
RAWG_REQUESTS_PER_SECOND=1
STEAM_REQUESTS_PER_SECOND=1
IGDB_REQUESTS_PER_SECOND=1
WIKIMEDIA_REQUESTS_PER_MINUTE=60
RAWG_MONTHLY_LIMIT=20000
RAWG_PAGE_SIZE=40
RAWG_DISCOVERY_PAGE_LIMIT=10
RAWG_DETAILS_LIMIT=0
DEMO_MODE=true
RAWG_RATE_LIMIT_PER_MINUTE=60
WIKIDATA_RATE_LIMIT_PER_MINUTE=60
STEAM_RATE_LIMIT_PER_MINUTE=30
WIKIPEDIA_RATE_LIMIT_PER_MINUTE=30
IGDB_RATE_LIMIT_PER_MINUTE=20

DATA_ROOT=/app/data

MLFLOW_TRACKING_URI=http://mlflow:5000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=gip-artifacts

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me

LLM_PROVIDER=none
OPENAI_API_KEY=replace-me
